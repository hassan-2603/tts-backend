# ===== Trader Tracking System (TTS) — Server Settings =====
# Copy this file to .env and fill in the required values. Never commit .env.

# Address people use to open the dashboard (e.g. http://localhost:8000 for local, or https://your-domain.com for production)
PUBLIC_URL=http://localhost:8000

# Secret key for JWT session cookies (32+ hex characters)
SECRET_KEY=e9a5c82a1f4b3d7e802c6f1a9b4d8e2f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d

# Database (PostgreSQL is required for production; SQLite aiosqlite for local testing)
DATABASE_URL=postgresql+asyncpg://tts:tts_password_secure@localhost:5432/tts_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Optional Redis for distributed lock & multi-worker coordination
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Service execution mode: set to true if running everything in a single web service (Render, Railway, etc.)
RUN_WORKER_IN_PROCESS=false
RUN_SCHEDULER_IN_PROCESS=false

# Token Encryption Key for tokens stored at rest (32 bytes urlsafe string)
TOKEN_ENCRYPTION_KEY=TTS_ENCRYPTION_KEY_32_BYTES_HEX1234567890abcdef

# Zebu / MYNT OAuth app credentials (from Zebu API portal)
ZEBU_BASE_URL=https://go.mynt.in
ZEBU_WS_URL=wss://go.mynt.in/NorenWSTP/
ZEBU_CLIENT_ID=47000S19
ZEBU_SECRET_KEY=rb0kc9o9UyPd3Tn8XivBYNQjA1C1VSd8

# First admin login for the dashboard (change the password!)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Concurrency & Sync Timing (IST)
MAX_CONCURRENT_ACCOUNTS=50
ACCOUNT_SYNC_WORKERS=10
POLL_SECONDS=120
MARKET_OPEN=09:10
MARKET_CLOSE=15:40
REBUILD_LOOKBACK_DAYS=30
DISABLE_SCHEDULER=0

# Manual vs Algo: orders whose Zebu "ordersource" is in this list are tagged Algo
ALGO_ORDERSOURCES=API
# ...or whose order remarks start with this text (e.g. your bridge tag). Leave empty to ignore.
ALGO_REMARK_PREFIX=

# Zebu product codes -> MIS (intraday) / NRML (carry forward)
PRODUCT_MAP={"I":"MIS","M":"NRML","C":"CNC","B":"MIS","H":"MIS"}

# Charges estimate for index options — check against your Zebu contract note
CHG_BROKERAGE_PER_ORDER=20
CHG_STT_SELL_PCT=0.1
CHG_TXN_PCT=0.03503
CHG_STAMP_BUY_PCT=0.003

# Index tokens used for "spot at entry" if GetIndexList does not find them (exch:token)
INDEX_TOKENS=BANKNIFTY=NSE:26009,NIFTY=NSE:26000,FINNIFTY=NSE:26037,MIDCPNIFTY=NSE:26074,SENSEX=BSE:1

# ----- Alerts (Optional) -----
# Telegram: create bot with @BotFather, put token here; chat ID configured in dashboard Settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API=https://api.telegram.org

# WhatsApp: webhook (Interakt, Gupshup, Twilio). Receives POST {"to","text"}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
